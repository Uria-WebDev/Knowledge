{% extends 'base.html.twig' %}

{% block title %}Knowledge - {{ lesson.name }}{% endblock %}

{% block lessonText %}
<div class="container">

    <h1 class="margin-top-3 margin-bottom-3">
        {{ lesson.name }}
    </h1>

    <p>{{ lesson.text }}</p>

    <form method="post" action="{{ path('lesson_validate', {id: lesson.id}) }}">
        <input type="checkbox"
            onchange="this.form.submit()"
            {% if userLesson and userLesson.isValidated %}checked{% endif %}>
        Valider la leçon
    </form>

</div>
{% endblock %}