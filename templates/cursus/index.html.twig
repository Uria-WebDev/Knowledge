{% extends 'base.html.twig' %}

{% block title %}Knowledge - {{ theme.name }}{% endblock %}

{% block cursus %}
<div class="container">

    <h1 class="margin-top-3 margin-bottom-3">
        Nos Cursus pour le Thème : {{ theme.name }}
    </h1>

    <div class="row">
        {% for cursus in cursus %}
        <div class="col-md-6 mb-3">
            <div class="card text-center padding-top-10 padding-bottom-10 background-blue decoration-none">
                <div class="card-body text-center">
                    <h5>{{ cursus.name }}</h5>
                    <p>{{ cursus.price }} €</p>
                    <a href="{{ path('cursus_lesson', {id: cursus.id}) }}"
                        class="btn background-darkblue background-blue-hov mt-3 width-100">
                        Voir
                    </a>

                    <form action="{{ path('cart_add') }}" method="POST">
                        <input type="hidden" name="cursus_id" value="{{ cursus.id }}">
                        <input type="hidden" name="size" id="selected-size">

                        <button type="submit" class="btn background-darkblue background-blue-hov mt-3 width-100">
                            Ajouter au panier
                        </button>
                    </form>
                </div>
            </div>
        </div>
        {% else %}
        <p>Aucun cursus disponible pour ce thème.</p>
        {% endfor %}
    </div>

</div>
{% endblock %}