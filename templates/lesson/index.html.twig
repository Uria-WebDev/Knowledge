{% extends 'base.html.twig' %}

{% block title %}Knowledge - {{ cursus.name }}{% endblock %}

{% block lesson %}
<div class="container">

    <h1 class="margin-top-3 margin-bottom-3">
        Nos Leçons pour le Cursus : {{ cursus.name }}
    </h1>

    <div class="row">
        {% for lesson in lesson %}
        <div class="col-md-6 mb-3">
            <div class="card text-center padding-top-10 padding-bottom-10 background-darkblue background-blue-hov decoration-none">
                <div class="card-body text-center">
                    <h5>{{ lesson.name }}</h5>
                    <p>{{ lesson.price }} €</p>
                    <a href="{{ path('lesson_read', {id: lesson.id}) }}"
                        class="btn background-darkblue background-blue-hov mt-3 width-100">
                        Voir
                    </a>

                    <form action="{{ path('cart_add') }}" method="POST">
                        <input type="hidden" name="lesson_id" value="{{ lesson.id }}">

                        <button type="submit" class="btn background-darkblue background-blue-hov mt-3 width-100">
                            Ajouter au panier
                        </button>
                    </form>
                </div>
            </div>
        </div>
        {% else %}
        <p>Aucune leçon disponible pour ce cursus.</p>
        {% endfor %}
    </div>

</div>
{% endblock %}