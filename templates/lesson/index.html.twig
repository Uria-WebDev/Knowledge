{% extends 'base.html.twig' %}

{% block title %}Knowledge - {{ cursus.name }}{% endblock %}

{% block lesson %}

<div class="container">

    <h1 class="margin-top-3 margin-bottom-3">
        Nos Leçons pour le Cursus : {{ cursus.name }}</br>
    </h1>

    {% if isCursusValidated %}
        <p>
            Cursus
            <span class="text-success"> Validé ✅</span>
        </p>
    {% endif %}

    <div class="row">
        {% for lesson in lesson %}

        {% set canAccess = false %}

        {% if user %}

            {# Vérifie si la leçon est achetée #}
            {% if lesson in user.lessonsBought %}
                {% set canAccess = true %}
            {% endif %}

            {# Vérifie si le cursus est acheté #}
            {% if cursus in user.cursusBought %}
                {% set canAccess = true %}
            {% endif %}
        {% endif %}

        <div class="col-md-6 mb-3">
            <div class="card text-center padding-top-10 padding-bottom-10 background-darkblue background-blue-hov decoration-none">
                <div class="card-body text-center">
                    <h5>{{ lesson.name }}</h5>
                    <p>{{ lesson.price }} €</p>

                    {# Affichage conditionnel du bouton #}
                    {% if canAccess %}
                        <a href="{{ path('lesson_read', {id: lesson.id}) }}"
                            class="btn background-darkblue background-green-hov mt-3 width-100">
                            Voir
                        </a>
                    {% else %}
                        <button class="btn background-red mt-3 width-100" disabled>
                            🔒 Acheter pour accéder
                        </button>
                    {% endif %}

                    <form action="{{ path('cart_add') }}" method="POST">
                        <input type="hidden" name="lesson_id" value="{{ lesson.id }}">

                        <button type="submit" class="btn background-darkblue background-green-hov mt-3 width-100">
                            Ajouter au panier
                        </button>
                    </form>
                </div>
            </div>
        </div>
        {% else %}
        <p>Aucune leçon disponible pour ce cursus.</p>
        {% endfor %}
    </div>

</div>
{% endblock %}